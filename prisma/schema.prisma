generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(cuid())
  studentNumber String?           @unique
  name          String
  firstName     String?
  middleName    String?
  lastName      String?
  nameExtension String?
  course        String?
  email         String            @unique
  password      String
  role          UserRole          @default(STUDENT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  requests      DocumentRequest[]
  notifications Notification[]
  reviewedPayments Payment[]      @relation("PaymentReviewer")
  paymentAuditEntries PaymentAudit[] @relation("PaymentAuditActor")
}

model DocumentRequest {
  id                String                 @id @default(cuid())
  requestNumber     String                 @unique
  documentType      DocumentType
  purpose           String
  status            RequestStatus          @default(SUBMITTED)
  remarks           String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  completedAt       DateTime?
  studentId         String
  student           User                   @relation(fields: [studentId], references: [id])
  payment           Payment?
  requestItems      RequestItem[]
  paymentAudits     PaymentAudit[]
  statusHistory     RequestStatusHistory[]
  uploadedDocuments UploadedDocument[]
}

model RequestItem {
  id           String          @id @default(cuid())
  requestId    String
  documentType DocumentType
  quantity     Int
  unitPrice    Decimal         @db.Decimal(10, 2)
  subtotal     Decimal         @db.Decimal(10, 2)
  createdAt    DateTime        @default(now())
  request      DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model UploadedDocument {
  id         String          @id @default(cuid())
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedAt DateTime        @default(now())
  requestId  String
  request    DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Payment {
  id                   String          @id @default(cuid())
  transactionReference String?
  proofFileUrl         String?
  amount               Decimal?        @db.Decimal(10, 2)
  verified             Boolean         @default(false)
  status               PaymentStatus   @default(PENDING)
  method               PaymentMethod?
  paidAt               DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  requestId            String          @unique
  request              DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rejectionReason      String?
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           User?           @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  auditHistory         PaymentAudit[]
}

model PaymentAudit {
  id              String              @id @default(cuid())
  paymentId       String
  requestId       String
  previousStatus  PaymentStatus
  newStatus       PaymentStatus
  action          PaymentAuditAction
  actorId         String
  rejectionReason String?
  isBackfilled    Boolean             @default(false)
  createdAt       DateTime            @default(now())
  payment         Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  request         DocumentRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor           User                @relation("PaymentAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([requestId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([action, newStatus, createdAt])
}

model RequestStatusHistory {
  id        String          @id @default(cuid())
  status    RequestStatus
  remarks   String?
  createdAt DateTime        @default(now())
  requestId String
  request   DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Notification {
  id            String           @id @default(cuid())
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  userId        String
  requestNumber String?
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum UserRole {
  STUDENT
  REGISTRAR
  TREASURY
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  PROCESSING
  READY_FOR_RELEASE
  COMPLETED
  REJECTED
}

enum DocumentType {
  TOR
  COR
  CERTIFICATE_OF_ENROLLMENT
  CERTIFIED_TRUE_COPY_OF_GRADES
}

enum NotificationType {
  REQUEST_SUBMITTED
  STATUS_UPDATED
  PAYMENT_SUBMITTED
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
}

enum PaymentAuditAction {
  CONFIRMED
  REJECTED
}

enum PaymentMethod {
  GCASH
  MAYA
  GRABPAY
  SHOPEEPAY
  COINS_PH
  BPI_ONLINE
  BDO_ONLINE
  METROBANK
  UNIONBANK
  RCBC
  SECURITY_BANK
  PNB
  LANDBANK
  CHINABANK
}
